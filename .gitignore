.DS_Store
*.swp
*.swo
*~
.claude/

# Session-state files — ephemeral per-conversation artifacts (progress
# trackers, session handoffs). If one of these ever needs to ship, commit
# with `git add -f <path>`.
PROGRESS.md
HANDOFF-*.md
SESSION_LOG.md
SESSION-*.md

# Probe infrastructure backups — session-local one-time snapshots.
# Naming convention: <script>.pre-<revision>-orig or .probe-*-orig
*.pre-*-orig
*.probe-*-orig

# Local tmp + logs for probe runs (project-directory ephemera)
/tmp/probe-*

__pycache__/
*.pyc
active-capabilities.yaml
