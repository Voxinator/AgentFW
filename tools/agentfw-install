#!/usr/bin/env bash
# agentfw-install — AgentFW r9 installer for Claude Code.
#
# Subcommands: install | upgrade | uninstall | status
# Target dir:  ${CLAUDE_DIR:-$HOME/.claude}   (CLAUDE_DIR override lets tests run in a sandbox)
#
# Convention (PLAN-r9 S9): AgentFW content in CLAUDE.md lives between exactly
#   <!-- AGENTFW:BEGIN r9 -->  and  <!-- AGENTFW:END r9 -->
# on their own lines. Non-AgentFW user content is preserved byte-for-byte.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ADAPTER_DIR="$REPO_ROOT/adapters/claude-code"
POLICY_SRC="$REPO_ROOT/policy"
PAYLOAD="$ADAPTER_DIR/CLAUDE-block.md"

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
TARGET="$CLAUDE_DIR/CLAUDE.md"
SKILL_DEST="$CLAUDE_DIR/skills/agentfw"
AGENTS_DEST="$CLAUDE_DIR/agents"

BEGIN_MARK='<!-- AGENTFW:BEGIN r9 -->'
END_MARK='<!-- AGENTFW:END r9 -->'
MARKER_RE='AGENTFW:BEGIN'

VERSION_TAG='r9'

log() { printf '%s\n' "$*"; }
die() { printf 'agentfw-install: ERROR: %s\n' "$*" >&2; exit 1; }

require_sources() {
  [ -f "$PAYLOAD" ] || die "payload not found: $PAYLOAD"
  [ -d "$ADAPTER_DIR/skills/agentfw" ] || die "adapter skill dir not found: $ADAPTER_DIR/skills/agentfw"
  [ -d "$ADAPTER_DIR/agents" ] || die "adapter agents dir not found: $ADAPTER_DIR/agents"
  [ -d "$POLICY_SRC" ] || die "repo policy/ dir not found at $POLICY_SRC — the skill's ./policy/ references cannot resolve without it"
}

timestamp() { date +%Y%m%d-%H%M%S; }

# Backup $TARGET (if present). Prints the backup path, or nothing if no file existed.
backup_target() {
  [ -f "$TARGET" ] || return 0
  local base="$TARGET.agentfw-backup-$(timestamp)" bak n=1
  bak="$base"
  while [ -e "$bak" ]; do bak="$base.$n"; n=$((n+1)); done
  cp -p "$TARGET" "$bak"
  printf '%s\n' "$bak"
}

# Emit the fully wrapped block (markers + payload) to stdout.
emit_block() {
  printf '%s\n' "$BEGIN_MARK"
  cat "$PAYLOAD"
  printf '%s\n' "$END_MARK"
}

has_marker_block() { [ -f "$TARGET" ] && grep -q "$MARKER_RE" "$TARGET"; }

# Marker-less legacy detection: r6/r7/r8 heading heuristics.
detect_legacy() {
  [ -f "$TARGET" ] || return 1
  grep -qE '^# AgentFW — Core Instructions|^#{1,2} .*Agentic Harness Framework' "$TARGET"
}

copy_assets() {
  mkdir -p "$SKILL_DEST" "$AGENTS_DEST"
  # Skill (our namespace — safe to refresh wholesale).
  rm -rf "$SKILL_DEST"
  mkdir -p "$SKILL_DEST"
  cp -R "$ADAPTER_DIR/skills/agentfw/." "$SKILL_DEST/"
  # Neutral policy, copied so ./policy/ references in SKILL.md resolve without the repo.
  rm -rf "$SKILL_DEST/policy"
  mkdir -p "$SKILL_DEST/policy"
  cp -R "$POLICY_SRC/." "$SKILL_DEST/policy/"
  # Agent definitions.
  for f in "$ADAPTER_DIR"/agents/agentfw-*.md; do
    cp -p "$f" "$AGENTS_DEST/"
  done
  log "Installed skill    -> $SKILL_DEST (policy/ included)"
  log "Installed agents   -> $AGENTS_DEST/$(cd "$ADAPTER_DIR/agents" && ls agentfw-*.md | tr '\n' ' ')"
}

# Replace the FIRST existing AGENTFW block in place with the new one; drop any extra blocks.
replace_block_in_place() {
  local tmp block
  tmp="$(mktemp)"; block="$(mktemp)"
  emit_block > "$block"
  awk -v blockfile="$block" '
    /AGENTFW:BEGIN/ {
      inblock = 1
      if (!emitted) { while ((getline line < blockfile) > 0) print line; close(blockfile); emitted = 1 }
      next
    }
    /AGENTFW:END/ { if (inblock) { inblock = 0; next } }
    inblock { next }
    { print }
  ' "$TARGET" > "$tmp"
  mv "$tmp" "$TARGET"
  rm -f "$block"
}

append_block() {
  if [ -s "$TARGET" ]; then
    # Ensure exactly one separating blank line; never modify existing bytes.
    [ -n "$(tail -c 1 "$TARGET")" ] && printf '\n' >> "$TARGET"
    printf '\n' >> "$TARGET"
  fi
  emit_block >> "$TARGET"
}

# --- marker-less legacy excision -------------------------------------------------------------
# Conservative: excise from the AgentFW heading through the last AgentFW-known section, ending
# tail content at the first plain-text line that does not look like list/blockquote/table
# continuation. On ambiguity (multiple AgentFW headings, interleaved unknown sections, no known
# section body), refuse — never guess-delete user content.
#
# Writes: excision range "start end" to stdout on success; exits non-zero with reason on refusal.
legacy_excise_range() {
  awk '
    function is_known_h2(l) {
      return l ~ /^## (CRITICAL RULES|The Governance Mindset|The Harness Mindset|Core Pattern|Plan-Critique Gate|Role Separation|Planner-Worker-Judge|Classification Gate|Task Delegation|Two Enforcement Gates|Permission Policy|Permission Protocol|Anti-Patterns|Error Recovery|Session Protocol|Reference Loading Protocol|Reference Index)/
    }
    function is_continuation(l) {
      return l ~ /^[[:space:]]*$/ || l ~ /^- / || l ~ /^\* / || l ~ /^> / || l ~ /^\|/ || l ~ /^[0-9]+\. / || l ~ /^```/ || l ~ /^    /
    }
    { L[NR] = $0 }
    END {
      start = 0; headcount = 0
      for (i = 1; i <= NR; i++) {
        if (L[i] ~ /^# AgentFW/ || (L[i] ~ /^#/ && L[i] ~ /Agentic Harness Framework/)) {
          headcount++
          if (!start) start = i
        }
      }
      if (!start) { print "REFUSE: no AgentFW heading found" > "/dev/stderr"; exit 3 }
      if (headcount > 1) { print "REFUSE: multiple AgentFW headings — ambiguous, merge manually" > "/dev/stderr"; exit 4 }
      head = start
      # Include an immediately preceding AgentFW HTML comment (e.g. "<!-- AgentFW v8 ... -->").
      if (start > 1 && L[start-1] ~ /^<!--.*AgentFW/) start--
      # Scan level-1/2 headings after the AgentFW heading itself.
      lastknown = 0; boundary = NR + 1
      for (i = head + 1; i <= NR; i++) {
        if (L[i] ~ /^##? /) {
          if (is_known_h2(L[i])) {
            if (boundary <= NR) { print "REFUSE: AgentFW section found after non-AgentFW section — interleaved, merge manually" > "/dev/stderr"; exit 5 }
            lastknown = i
          } else if (boundary > NR) {
            boundary = i
          }
        }
      }
      if (!lastknown) { print "REFUSE: AgentFW heading found but no known AgentFW section follows — ambiguous, merge manually" > "/dev/stderr"; exit 6 }
      # Tail: extend from the last known heading only through continuation-shaped lines.
      end = lastknown
      for (i = lastknown + 1; i < boundary; i++) {
        if (is_continuation(L[i])) end = i; else break
      }
      # Trim trailing blank lines out of the excision (leave separation for what follows).
      while (end > start && L[end] ~ /^[[:space:]]*$/) end--
      print start, end
    }
  ' "$TARGET"
}

do_status() {
  log "CLAUDE_DIR:      $CLAUDE_DIR"
  if [ -f "$TARGET" ]; then
    local n version
    n=$(grep -c "$MARKER_RE" "$TARGET" || true)
    if [ "$n" -gt 0 ]; then
      version=$(grep -m1 "$MARKER_RE" "$TARGET" | sed -E 's/.*AGENTFW:BEGIN[[:space:]]*([^ >-]*).*/\1/')
      log "CLAUDE.md:       present — AgentFW block installed (version tag: ${version:-unknown}; blocks: $n)"
    elif detect_legacy; then
      log "CLAUDE.md:       present — marker-less legacy AgentFW content detected (r6/r7/r8). Run: agentfw-install upgrade"
    else
      log "CLAUDE.md:       present — no AgentFW block"
    fi
  else
    log "CLAUDE.md:       absent"
  fi
  if [ -d "$SKILL_DEST" ]; then
    log "Skill:           $SKILL_DEST present$( [ -d "$SKILL_DEST/policy" ] && printf ' (policy/ present)' || printf ' (policy/ MISSING)')"
  else
    log "Skill:           absent"
  fi
  local agents
  agents=$(ls "$AGENTS_DEST"/agentfw-*.md 2>/dev/null | tr '\n' ' ' || true)
  if [ -n "${agents:-}" ]; then log "Agents:          $agents"; else log "Agents:          absent"; fi
}

do_install() {
  require_sources
  mkdir -p "$CLAUDE_DIR"
  if has_marker_block; then
    log "Existing AGENTFW block found — install behaves as upgrade (single block, replaced in place)."
    do_upgrade
    return
  fi
  if detect_legacy; then
    log "Marker-less legacy AgentFW content detected — install behaves as upgrade."
    do_upgrade
    return
  fi
  local bak=""
  if [ -f "$TARGET" ]; then
    bak=$(backup_target)
    log "Backed up existing CLAUDE.md -> $bak"
  fi
  touch "$TARGET"
  append_block
  copy_assets
  log "Inserted AgentFW $VERSION_TAG block into $TARGET (existing content preserved)."
  log "NOTE: settings.json is never auto-modified. Merge $ADAPTER_DIR/settings.example.json manually."
  log "Install complete."
}

do_upgrade() {
  require_sources
  mkdir -p "$CLAUDE_DIR"
  if [ ! -f "$TARGET" ]; then
    log "No existing CLAUDE.md — performing fresh install."
    touch "$TARGET"
    append_block
    copy_assets
    log "Install complete."
    return
  fi
  local bak
  if has_marker_block; then
    bak=$(backup_target)
    log "Backed up CLAUDE.md -> $bak"
    replace_block_in_place
    copy_assets
    log "Replaced existing AGENTFW block (any prior version tag) with $VERSION_TAG, in place."
    log "Upgrade complete."
    return
  fi
  if detect_legacy; then
    log "Detected marker-less legacy AgentFW install (r6/r7/r8 heading heuristics matched)."
    local range start end
    if ! range=$(legacy_excise_range); then
      die "legacy content detected but excision is ambiguous — refusing to guess. Merge manually: remove the old AgentFW sections from $TARGET yourself, then re-run 'agentfw-install install'. See adapters/claude-code/UPGRADE.md."
    fi
    start=${range% *}; end=${range#* }
    bak=$(backup_target)
    log "Backed up CLAUDE.md (full original, including the excised AgentFW content) -> $bak"
    log "Excising legacy AgentFW content: lines $start-$end of $TARGET (everything else preserved)."
    local tmp block
    tmp="$(mktemp)"; block="$(mktemp)"
    emit_block > "$block"
    awk -v s="$start" -v e="$end" -v blockfile="$block" '
      NR == s { while ((getline line < blockfile) > 0) print line; close(blockfile) }
      NR >= s && NR <= e { next }
      { print }
    ' "$TARGET" > "$tmp"
    mv "$tmp" "$TARGET"
    rm -f "$block"
    copy_assets
    log "Upgrade complete (legacy content excised into backup; new $VERSION_TAG block inserted in place)."
    return
  fi
  log "No AgentFW content found in $TARGET — performing fresh install (append)."
  bak=$(backup_target)
  [ -n "${bak:-}" ] && log "Backed up CLAUDE.md -> $bak"
  append_block
  copy_assets
  log "Install complete."
}

do_uninstall() {
  local removed=0
  log "AgentFW $VERSION_TAG uninstall — inventory of removals:"
  if [ -f "$TARGET" ] && grep -q "$MARKER_RE" "$TARGET"; then
    local bak tmp
    bak=$(backup_target)
    log "  - Backed up CLAUDE.md before edit -> $bak"
    tmp="$(mktemp)"
    # Strip every AGENTFW block (any version tag) plus the single separating blank line the
    # installer added before it, restoring the user's file byte-for-byte.
    awk '
      { L[NR] = $0 }
      END {
        inb = 0
        for (i = 1; i <= NR; i++) {
          if (L[i] ~ /AGENTFW:BEGIN/) {
            inb = 1; del[i] = 1
            if (i > 1 && L[i-1] ~ /^[[:space:]]*$/ && !del[i-1]) del[i-1] = 1
          } else if (L[i] ~ /AGENTFW:END/) {
            del[i] = 1; inb = 0
          } else if (inb) del[i] = 1
        }
        for (i = 1; i <= NR; i++) if (!del[i]) print L[i]
      }
    ' "$TARGET" > "$tmp"
    if grep -q '[^[:space:]]' "$tmp"; then
      mv "$tmp" "$TARGET"
      log "  - Removed AGENTFW marker block(s) from $TARGET (all other content preserved)"
    else
      rm -f "$tmp" "$TARGET"
      log "  - $TARGET contained only the AgentFW block — file removed"
    fi
    removed=1
  else
    log "  - No AGENTFW marker block in ${TARGET} (nothing to remove there)"
  fi
  if [ -d "$SKILL_DEST" ]; then
    rm -rf "$SKILL_DEST"
    log "  - Removed skill dir $SKILL_DEST (including policy/)"
    removed=1
  else
    log "  - Skill dir absent ($SKILL_DEST)"
  fi
  local f found=0
  for f in "$AGENTS_DEST"/agentfw-*.md; do
    [ -e "$f" ] || continue
    rm -f "$f"
    log "  - Removed agent $f"
    found=1; removed=1
  done
  [ "$found" -eq 0 ] && log "  - No agentfw-*.md agent files in $AGENTS_DEST"
  log "NOT removed (intentional): backup files ($CLAUDE_DIR/CLAUDE.md.agentfw-backup-*) and any"
  log "settings.json entries you merged manually — remove those by hand (see UNINSTALL.md)."
  [ "$removed" -eq 1 ] && log "Uninstall complete." || log "Nothing was installed; nothing removed."
}

usage() {
  cat <<EOF
Usage: agentfw-install <install|upgrade|uninstall|status>

Target: \${CLAUDE_DIR:-\$HOME/.claude}  (currently: $CLAUDE_DIR)

  install    Insert the AgentFW $VERSION_TAG block into CLAUDE.md (backup first; append —
             never overwrite user content), install the agentfw skill (+ policy/) and the
             agentfw-* agents. Idempotent: an existing block makes install behave as upgrade.
  upgrade    Replace any existing AGENTFW block (any version tag); detect marker-less r6/r7/r8
             installs by heading heuristics and conservatively excise them into a backup;
             refuse when ambiguous.
  uninstall  Remove the block, the skill dir, and the agentfw-* agents; preserve everything
             else byte-for-byte; remove CLAUDE.md if it becomes empty; print an inventory.
  status     Report block presence/version, skill dir, agent files.
EOF
}

cmd="${1:-}"
case "$cmd" in
  install)   do_install ;;
  upgrade)   do_upgrade ;;
  uninstall) do_uninstall ;;
  status)    do_status ;;
  ""|-h|--help) usage; [ -n "$cmd" ] || exit 1 ;;
  *) usage; die "unknown subcommand: $cmd" ;;
esac
