#!/usr/bin/env bash
# agentfw-install — AgentFW r9 installer for Claude Code.
#
# Subcommands: install | upgrade | uninstall | status
# Target dir:  ${CLAUDE_DIR:-$HOME/.claude}   (CLAUDE_DIR override lets tests run in a sandbox)
#
# Convention (PLAN-r9 S9): AgentFW content in CLAUDE.md lives between exactly
#   <!-- AGENTFW:BEGIN r9 -->  and  <!-- AGENTFW:END r9 -->
# on their own lines. Non-AgentFW user content is preserved byte-for-byte.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ADAPTER_DIR="$REPO_ROOT/adapters/claude-code"
POLICY_SRC="$REPO_ROOT/policy"
VALIDATOR_SRC="$REPO_ROOT/tools/validate-plan"
PAYLOAD="$ADAPTER_DIR/CLAUDE-block.md"

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
TARGET="$CLAUDE_DIR/CLAUDE.md"
SKILL_DEST="$CLAUDE_DIR/skills/agentfw"
AGENTS_DEST="$CLAUDE_DIR/agents"

BEGIN_MARK='<!-- AGENTFW:BEGIN r9 -->'
END_MARK='<!-- AGENTFW:END r9 -->'
# Block detection is anchored to the exact HTML-comment marker at line start, WORD-BOUNDED by
# the mandatory space after BEGIN/END (real markers are always '<!-- AGENTFW:BEGIN <tag> -->').
# A bare substring match (the old 'AGENTFW:BEGIN') fires on PROSE mentions of the marker names
# in user content — which made install/upgrade/uninstall destroy user lines — and an
# un-word-bounded prefix match (the old '^<!-- AGENTFW:BEGIN') fires on lookalike comments such
# as '<!-- AGENTFW:BEGINNING of notes -->', causing false refusals. Never loosen these.
#
# Additionally, EVERY marker scanner is code-fence-aware via the shared CommonMark-aware
# FENCE_TRACKER prelude below, so the integrity check and the mutation paths can never disagree
# about what counts as the real block. Tracker semantics:
#   - An OPENING fence is a run of >=3 backticks OR >=3 tildes (one character, one run), with
#     up to 3 leading spaces, optionally followed by an info string. For backtick fences the
#     info string must not contain a backtick (so a line like ```foo``` is NOT a fence opener);
#     for tilde fences the info string may contain anything.
#   - The fence CHARACTER and OPENING RUN LENGTH are recorded. While inside a fence, a line
#     closes it ONLY if it is the SAME character repeated >= the opening length, with up to 3
#     leading spaces and nothing else but trailing whitespace (spaces/tabs/CR — a CRLF file's
#     '```\r' closes its fence; no false 'unclosed' refusal on well-formed CRLF files).
#     Anything else — including SHORTER runs and runs of the OTHER character — is fence
#     content (a ````-opened fence containing ``` lines stays open).
#   - Marker lines inside any open fence are invisible to every scanner: detection, the
#     integrity check, upgrade replacement, uninstall stripping, and status counting alike.
# UNCLOSED fence at EOF: install/upgrade/uninstall REFUSE (die, file byte-untouched, before any
# backup/copy side effects) — prose after an unclosed fence is ambiguous and we must never risk
# deleting user content on ambiguity; status warns but exits 0. (The old silent
# "everything-after-is-fenced" semantics are gone.)
MARKER_RE='^<!-- AGENTFW:BEGIN '
END_RE='^<!-- AGENTFW:END '

# Shared CommonMark-aware fence tracker, prepended VERBATIM to EVERY awk marker scanner (and
# mirrored in tools/tests/install-roundtrip.sh). Maintains `infence` (plus `fchar`/`flen`, the
# open fence's character and run length); every marker match below is qualified with
# `!infence`, and END blocks may test `infence` for unclosed-at-EOF detection.
FENCE_TRACKER='{
  ftl = $0
  sub(/^ ? ? ?/, "", ftl)
  ftc = substr(ftl, 1, 1)
  if (infence) {
    if (ftc == fchar) {
      ftn = 1
      while (substr(ftl, ftn + 1, 1) == fchar) ftn++
      if (ftn >= flen && substr(ftl, ftn + 1) ~ /^[ \t\r]*$/) infence = 0
    }
  } else if (ftc == "`" || ftc == "~") {
    ftn = 1
    while (substr(ftl, ftn + 1, 1) == ftc) ftn++
    if (ftn >= 3 && (ftc == "~" || substr(ftl, ftn + 1) !~ /`/)) {
      infence = 1; fchar = ftc; flen = ftn
    }
  }
}
'

VERSION_TAG='r9'

# Set to 1 when the ORIGINAL pre-install CLAUDE.md ended WITHOUT a final newline. The append/
# rewrite paths necessarily terminate that last line, so the fact is recorded as a manifest
# directive ('#agentfw:no-final-newline', written by copy_assets, preserved across upgrades)
# and consumed by uninstall to restore the file byte-identically.
NO_FINAL_NEWLINE=0
NO_FINAL_NEWLINE_DIRECTIVE='#agentfw:no-final-newline'

log() { printf '%s\n' "$*"; }
die() { printf 'agentfw-install: ERROR: %s\n' "$*" >&2; exit 1; }

# Emit one arbitrary shell string as a YAML double-quoted scalar. command/type output can include
# function bodies, quotes, backslashes, newlines, tabs, and other control bytes; writing it as an
# unquoted scalar or block body would let a wrapper corrupt the generated YAML structure. Bash
# variables cannot contain NUL, but every other ASCII control byte is escaped explicitly. The
# resulting scalar is also valid JSON string syntax, which keeps it within YAML 1.2's safe subset.
yaml_quote() {
  local s="${1-}"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\001'/\\u0001}; s=${s//$'\002'/\\u0002}; s=${s//$'\003'/\\u0003}
  s=${s//$'\004'/\\u0004}; s=${s//$'\005'/\\u0005}; s=${s//$'\006'/\\u0006}
  s=${s//$'\007'/\\u0007}; s=${s//$'\010'/\\b};     s=${s//$'\011'/\\t}
  s=${s//$'\012'/\\n};     s=${s//$'\013'/\\u000B}; s=${s//$'\014'/\\f}
  s=${s//$'\015'/\\r};     s=${s//$'\016'/\\u000E}; s=${s//$'\017'/\\u000F}
  s=${s//$'\020'/\\u0010}; s=${s//$'\021'/\\u0011}; s=${s//$'\022'/\\u0012}
  s=${s//$'\023'/\\u0013}; s=${s//$'\024'/\\u0014}; s=${s//$'\025'/\\u0015}
  s=${s//$'\026'/\\u0016}; s=${s//$'\027'/\\u0017}; s=${s//$'\030'/\\u0018}
  s=${s//$'\031'/\\u0019}; s=${s//$'\032'/\\u001A}; s=${s//$'\033'/\\u001B}
  s=${s//$'\034'/\\u001C}; s=${s//$'\035'/\\u001D}; s=${s//$'\036'/\\u001E}
  s=${s//$'\037'/\\u001F}; s=${s//$'\177'/\\u007F}
  printf '"%s"' "$s"
}

require_sources() {
  [ -f "$PAYLOAD" ] || die "payload not found: $PAYLOAD"
  [ -d "$ADAPTER_DIR/skills/agentfw" ] || die "adapter skill dir not found: $ADAPTER_DIR/skills/agentfw"
  [ -d "$ADAPTER_DIR/agents" ] || die "adapter agents dir not found: $ADAPTER_DIR/agents"
  [ -d "$POLICY_SRC" ] || die "repo policy/ dir not found at $POLICY_SRC — the skill's ./policy/ references cannot resolve without it"
  [ -f "$ADAPTER_DIR/capability.yaml" ] || die "adapter capability instance not found: $ADAPTER_DIR/capability.yaml — the installed skill packages it; refusing to install without it"
  [ -f "$VALIDATOR_SRC" ] || die "plan validator not found at $VALIDATOR_SRC — the installed skill packages tools/validate-plan (single source, repo tools/); refusing to install without it"
}

timestamp() { date +%Y%m%d-%H%M%S; }

# Backup $TARGET (if present). Prints the backup path, or nothing if no file existed.
backup_target() {
  [ -f "$TARGET" ] || return 0
  local base="$TARGET.agentfw-backup-$(timestamp)" bak n=1
  bak="$base"
  while [ -e "$bak" ]; do bak="$base.$n"; n=$((n+1)); done
  cp -p "$TARGET" "$bak"
  printf '%s\n' "$bak"
}

# Emit the fully wrapped block (markers + payload) to stdout.
emit_block() {
  printf '%s\n' "$BEGIN_MARK"
  cat "$PAYLOAD"
  printf '%s\n' "$END_MARK"
}

# Fence-aware BEGIN detection (a plain grep cannot track fence state).
has_marker_block() {
  [ -f "$TARGET" ] || return 1
  awk -v bre="$MARKER_RE" "$FENCE_TRACKER"'
    !infence && $0 ~ bre { found = 1; exit }
    END { exit !found }
  ' "$TARGET"
}

# Marker lines must be properly paired and ordered (BEGIN then END, no nesting, no
# unterminated BEGIN, no stray END). An unterminated block would otherwise be deleted
# "to EOF" by the strip/replace awks. Fenced marker lines are ignored (see FENCE_TRACKER).
block_integrity_ok() {
  [ -f "$TARGET" ] || return 0
  awk "$FENCE_TRACKER"'
    !infence && /^<!-- AGENTFW:BEGIN / { if (inb) { bad = 1; exit } inb = 1; next }
    !infence && /^<!-- AGENTFW:END /   { if (!inb) { bad = 1; exit } inb = 0; next }
    END { if (inb) bad = 1; exit bad }
  ' "$TARGET"
}

# Refuse-on-ambiguity guard for every mutating subcommand: on malformed markers, die and
# change NOTHING, consistent with the legacy-excision refuse-on-ambiguity design.
require_block_integrity() {
  block_integrity_ok || die "malformed AGENTFW marker structure in $TARGET (unterminated BEGIN, stray END, or nested markers) — refusing to modify anything; the file is untouched. Repair manually: each '<!-- AGENTFW:BEGIN … -->' line needs exactly one matching '<!-- AGENTFW:END … -->' line after it, then re-run."
}

# Unclosed-fence detection: true (0) when every fence opened in $TARGET is closed by EOF.
fence_closed_ok() {
  [ -f "$TARGET" ] || return 0
  awk "$FENCE_TRACKER"'
    END { exit infence ? 1 : 0 }
  ' "$TARGET"
}

# Refuse-on-ambiguity guard for every mutating subcommand: with an unclosed fence, everything
# after the opener is ambiguous (fenced or prose?), so we die and change NOTHING — before any
# backup/copy side effects. status merely warns (see do_status).
require_no_unclosed_fence() {
  fence_closed_ok || die "unclosed code fence in $TARGET (a \`\`\`/~~~ fence is opened but never closed before EOF) — refusing to modify anything; the file is untouched. Close the fence (a line of the same character, at least as long as the opening run), then re-run."
}

# Marker-less legacy detection: r6/r7/r8 heading heuristics.
detect_legacy() {
  [ -f "$TARGET" ] || return 1
  grep -qE '^# AgentFW — Core Instructions|^#{1,2} .*Agentic Harness Framework' "$TARGET"
}

copy_assets() {
  # Preserve the no-final-newline record across manifest rewrites (upgrade / re-install): the
  # fact describes the ORIGINAL pre-install CLAUDE.md and must survive until uninstall. Read
  # the old manifest BEFORE the wholesale skill-dir refresh below deletes it.
  if [ "$NO_FINAL_NEWLINE" != 1 ] && [ -f "$SKILL_DEST/.install-manifest" ] \
     && grep -qF "$NO_FINAL_NEWLINE_DIRECTIVE" "$SKILL_DEST/.install-manifest" 2>/dev/null; then
    NO_FINAL_NEWLINE=1
  fi
  mkdir -p "$SKILL_DEST" "$AGENTS_DEST"
  # Skill (our namespace — safe to refresh wholesale).
  rm -rf "$SKILL_DEST"
  mkdir -p "$SKILL_DEST"
  cp -R "$ADAPTER_DIR/skills/agentfw/." "$SKILL_DEST/"
  # Neutral policy, copied so ./policy/ references in SKILL.md resolve without the repo.
  rm -rf "$SKILL_DEST/policy"
  mkdir -p "$SKILL_DEST/policy"
  cp -R "$POLICY_SRC/." "$SKILL_DEST/policy/"
  # Plan validator (single source: repo tools/validate-plan), copied so the skill's
  # ./tools/validate-plan reference resolves without a repo checkout.
  mkdir -p "$SKILL_DEST/tools"
  cp -p "$VALIDATOR_SRC" "$SKILL_DEST/tools/validate-plan"
  chmod +x "$SKILL_DEST/tools/validate-plan"
  # Adapter capability instance, packaged so the skill's ./capability.yaml reference resolves
  # without a repo checkout. Lives inside skills/agentfw — covered by the wholesale
  # 'skills/agentfw' manifest entry (same semantics as policy/ and tools/ above).
  cp -p "$ADAPTER_DIR/capability.yaml" "$SKILL_DEST/capability.yaml"
  # Agent definitions + install manifest. The manifest records EXACTLY what this run
  # installed; uninstall removes only manifest entries (never a glob), so user-created
  # files — including your own agentfw-*.md agents — are never touched.
  local manifest="$SKILL_DEST/.install-manifest" f
  {
    printf '# AgentFW %s install manifest — written by agentfw-install; consumed by uninstall.\n' "$VERSION_TAG"
    printf '# One CLAUDE_DIR-relative installed path per line. Uninstall removes EXACTLY these\n'
    printf '# paths plus the AGENTFW marker block inside CLAUDE.md — nothing else.\n'
    if [ "$NO_FINAL_NEWLINE" = 1 ]; then
      # Directive (comment-shaped, so path parsing skips it): the original CLAUDE.md ended
      # without a final newline; uninstall strips the one the installer had to add.
      printf '%s\n' "$NO_FINAL_NEWLINE_DIRECTIVE"
    fi
    printf 'skills/agentfw\n'
  } > "$manifest"
  for f in "$ADAPTER_DIR"/agents/agentfw-*.md; do
    cp -p "$f" "$AGENTS_DEST/"
    printf 'agents/%s\n' "$(basename "$f")" >> "$manifest"
  done
  log "Installed skill    -> $SKILL_DEST (policy/ + tools/validate-plan + capability.yaml included)"
  log "Installed agents   -> $AGENTS_DEST/$(cd "$ADAPTER_DIR/agents" && ls agentfw-*.md | tr '\n' ' ')"
  log "Wrote manifest     -> $manifest"
}

# Replace the FIRST existing AGENTFW block in place with the new one; drop any extra blocks.
replace_block_in_place() {
  local tmp block
  tmp="$(mktemp)"; block="$(mktemp)"
  emit_block > "$block"
  awk -v blockfile="$block" "$FENCE_TRACKER"'
    !infence && /^<!-- AGENTFW:BEGIN / {
      inblock = 1
      if (!emitted) { while ((getline line < blockfile) > 0) print line; close(blockfile); emitted = 1 }
      next
    }
    !infence && /^<!-- AGENTFW:END / { if (inblock) { inblock = 0; next } }
    inblock { next }
    { print }
  ' "$TARGET" > "$tmp"
  mv "$tmp" "$TARGET"
  rm -f "$block"
}

append_block() {
  if [ -s "$TARGET" ]; then
    # Ensure exactly one separating blank line; never ALTER existing bytes. Terminating an
    # unterminated last line adds a byte the user never wrote — record that (manifest
    # directive, via copy_assets) so uninstall can remove it again for a byte-exact restore.
    if [ -n "$(tail -c 1 "$TARGET")" ]; then
      NO_FINAL_NEWLINE=1
      printf '\n' >> "$TARGET"
    fi
    printf '\n' >> "$TARGET"
  fi
  emit_block >> "$TARGET"
}

# --- marker-less legacy excision -------------------------------------------------------------
# Conservative: excise from the AgentFW heading through the last AgentFW-known section, ending
# tail content at the first plain-text line that does not look like list/blockquote/table
# continuation. On ambiguity (multiple AgentFW headings, interleaved unknown sections, no known
# section body), refuse — never guess-delete user content.
#
# Writes: excision range "start end" to stdout on success; exits non-zero with reason on refusal.
legacy_excise_range() {
  awk '
    function is_known_h2(l) {
      return l ~ /^## (CRITICAL RULES|The Governance Mindset|The Harness Mindset|Core Pattern|Plan-Critique Gate|Role Separation|Planner-Worker-Judge|Classification Gate|Task Delegation|Two Enforcement Gates|Permission Policy|Permission Protocol|Anti-Patterns|Error Recovery|Session Protocol|Reference Loading Protocol|Reference Index)/
    }
    function is_continuation(l) {
      return l ~ /^[[:space:]]*$/ || l ~ /^- / || l ~ /^\* / || l ~ /^> / || l ~ /^\|/ || l ~ /^[0-9]+\. / || l ~ /^```/ || l ~ /^    /
    }
    { L[NR] = $0 }
    END {
      start = 0; headcount = 0
      for (i = 1; i <= NR; i++) {
        if (L[i] ~ /^# AgentFW/ || (L[i] ~ /^#/ && L[i] ~ /Agentic Harness Framework/)) {
          headcount++
          if (!start) start = i
        }
      }
      if (!start) { print "REFUSE: no AgentFW heading found" > "/dev/stderr"; exit 3 }
      if (headcount > 1) { print "REFUSE: multiple AgentFW headings — ambiguous, merge manually" > "/dev/stderr"; exit 4 }
      head = start
      # Include an immediately preceding AgentFW HTML comment (e.g. "<!-- AgentFW v8 ... -->").
      if (start > 1 && L[start-1] ~ /^<!--.*AgentFW/) start--
      # Scan level-1/2 headings after the AgentFW heading itself.
      lastknown = 0; boundary = NR + 1
      for (i = head + 1; i <= NR; i++) {
        if (L[i] ~ /^##? /) {
          if (is_known_h2(L[i])) {
            if (boundary <= NR) { print "REFUSE: AgentFW section found after non-AgentFW section — interleaved, merge manually" > "/dev/stderr"; exit 5 }
            lastknown = i
          } else if (boundary > NR) {
            boundary = i
          }
        }
      }
      if (!lastknown) { print "REFUSE: AgentFW heading found but no known AgentFW section follows — ambiguous, merge manually" > "/dev/stderr"; exit 6 }
      # Tail: extend from the last known heading only through continuation-shaped lines.
      end = lastknown
      for (i = lastknown + 1; i < boundary; i++) {
        if (is_continuation(L[i])) end = i; else break
      }
      # Trim trailing blank lines out of the excision (leave separation for what follows).
      while (end > start && L[end] ~ /^[[:space:]]*$/) end--
      print start, end
    }
  ' "$TARGET"
}

do_status() {
  log "CLAUDE_DIR:      $CLAUDE_DIR"
  if [ -f "$TARGET" ]; then
    local n version
    # Fence-aware count/extract (a plain grep would count fenced marker examples).
    n=$(awk -v bre="$MARKER_RE" "$FENCE_TRACKER"'
      !infence && $0 ~ bre { n++ }
      END { print n + 0 }
    ' "$TARGET")
    if [ "$n" -gt 0 ]; then
      version=$(awk -v bre="$MARKER_RE" "$FENCE_TRACKER"'
        !infence && $0 ~ bre { print; exit }
      ' "$TARGET" | sed -E 's/.*AGENTFW:BEGIN[[:space:]]*([^ >-]*).*/\1/')
      log "CLAUDE.md:       present — AgentFW block installed (version tag: ${version:-unknown}; blocks: $n)"
      block_integrity_ok || log "CLAUDE.md:       WARNING — malformed AGENTFW marker structure (unterminated BEGIN, stray END, or nested markers); install/upgrade/uninstall will refuse until repaired"
    elif detect_legacy; then
      log "CLAUDE.md:       present — marker-less legacy AgentFW content detected (r6/r7/r8). Run: agentfw-install upgrade"
    else
      log "CLAUDE.md:       present — no AgentFW block"
    fi
    fence_closed_ok || log "CLAUDE.md:       WARNING — unclosed code fence (a \`\`\`/~~~ fence is opened but never closed before EOF); install/upgrade/uninstall will refuse until it is closed"
  else
    log "CLAUDE.md:       absent"
  fi
  if [ -d "$SKILL_DEST" ]; then
    log "Skill:           $SKILL_DEST present$( [ -d "$SKILL_DEST/policy" ] && printf ' (policy/ present)' || printf ' (policy/ MISSING)')"
  else
    log "Skill:           absent"
  fi
  local agents
  agents=$(ls "$AGENTS_DEST"/agentfw-*.md 2>/dev/null | tr '\n' ' ' || true)
  if [ -n "${agents:-}" ]; then log "Agents:          $agents"; else log "Agents:          absent"; fi

  # --- configured-state probes ----------------------------------------------------------------
  # These map to the capability file's activation_probe entries (packaged as
  # $SKILL_DEST/capability.yaml; source adapters/claude-code/capability.yaml):
  # deterministic_permissions and independent_review. settings.json is NEVER modified by this
  # tool; the only thing status writes is $SKILL_DEST/active-capabilities.yaml (below).
  log ""
  log "Configured-state probes (capability activation_probe map):"

  # deterministic_permissions: settings.json presence + PER-RULE deny entries (yes/no, or
  # unknown when the file exists but cannot be read/parsed). The file is PARSED as JSON and
  # only COMPLETE rule entries inside permissions.deny count — signature substrings living in
  # comments, metadata keys, or permissions.allow/ask are NOT active deny rules and must not
  # be reported as such (a plain grep over the whole file does exactly that).
  # Containment is decided by canonical-form matching, never substring presence; unrecognized
  # forms report no — conservative. A rule reports yes ONLY when a deny entry provably covers
  # the canonical protection (exact match, after whitespace normalization):
  #   deny .ssh              <=> Read(~/.ssh/**) or Read(**/.ssh/**)
  #   deny .env              <=> Read(**/.env) — the broadest of the canonical trio
  #                              Read(./.env)/Read(./.env.*)/Read(**/.env); the narrower two
  #                              alone do not cover .env files outside the project root
  #   deny .aws              <=> Read(~/.aws/**) or Read(**/.aws/**)
  #   deny secrets           <=> Read(**/secrets/**)
  #   deny git push --force  <=> a Bash deny whose pattern, after stripping the trailing ':*'
  #                              argument matcher, BEGINS with 'git push' and carries
  #                              --force / -f / --force-with-lease as a flag token WITHIN THE
  #                              FIRST shell command (tokens at/after one containing ; | & are
  #                              ignored — a flag after '&&' does not belong to git push)
  # Narrower rules (Read(~/.ssh/known_hosts)), unrelated commands (Bash(echo git push --force
  # is bad:*)), and broader-but-noncanonical rules (Read(**)) all report NO — a false negative
  # is safe; a false 'yes' claims a protection that does not exist.
  # settings_schema_valid is a NON-GATING diagnostic: false when the JSON parsed but
  # permissions/deny had unexpected types; it never feeds the configured aggregate.
  # Missing file => all no. Present but unreadable, unparseable JSON, or no python3 => all
  # unknown (never yes, never a crash — python3 is already a dependency of the installed skill).
  local settings="$CLAUDE_DIR/settings.json" settings_present
  local deny_ssh deny_env deny_aws deny_secrets deny_git_push_force settings_schema_valid
  if [ ! -e "$settings" ]; then
    settings_present="no"
    deny_ssh=no; deny_env=no; deny_aws=no; deny_secrets=no; deny_git_push_force=no
    settings_schema_valid=true
    log "  deterministic_permissions: settings.json absent — all deny rules: no (merge settings.example.json manually)"
  elif [ ! -r "$settings" ]; then
    settings_present="unreadable"
    deny_ssh=unknown; deny_env=unknown; deny_aws=unknown; deny_secrets=unknown; deny_git_push_force=unknown
    settings_schema_valid=unknown
    log "  deterministic_permissions: settings.json present but unreadable — deny rules: unknown"
  elif ! command -v python3 >/dev/null 2>&1; then
    settings_present="yes"
    deny_ssh=unknown; deny_env=unknown; deny_aws=unknown; deny_secrets=unknown; deny_git_push_force=unknown
    settings_schema_valid=unknown
    log "  deterministic_permissions: settings.json present but python3 unavailable to parse it — deny rules: unknown"
  else
    settings_present="yes"
    local probe_out
    if probe_out=$(python3 - "$settings" <<'AGENTFW_PROBE_PY'
import json, sys

with open(sys.argv[1], "r", encoding="utf-8") as fh:
    data = json.load(fh)  # any parse/read error -> non-zero exit -> unknown

# Schema diagnostic (non-gating): false when the JSON parsed but the
# permissions / permissions.deny shape has unexpected types.
schema_valid = True
deny = []
if not isinstance(data, dict):
    schema_valid = False
else:
    perms = data.get("permissions")
    if perms is not None and not isinstance(perms, dict):
        schema_valid = False
    elif isinstance(perms, dict):
        raw = perms.get("deny")
        if raw is not None and not isinstance(raw, list):
            schema_valid = False
        elif isinstance(raw, list):
            if any(not isinstance(e, str) for e in raw):
                schema_valid = False
            deny = [e for e in raw if isinstance(e, str)]

# Containment is decided by canonical-form matching, never substring presence;
# unrecognized forms report no — conservative.
def norm(entry):
    return " ".join(entry.split())

entries = {norm(e) for e in deny}

SSH_FORMS     = {"Read(~/.ssh/**)", "Read(**/.ssh/**)"}
AWS_FORMS     = {"Read(~/.aws/**)", "Read(**/.aws/**)"}
SECRETS_FORMS = {"Read(**/secrets/**)"}
# env: yes ONLY when the deny includes Read(**/.env) — the broadest of the
# canonical trio Read(./.env) / Read(./.env.*) / Read(**/.env). The narrower
# two alone do not cover .env files outside the project root.
ENV_FORMS     = {"Read(**/.env)"}

ssh     = bool(entries & SSH_FORMS)
aws     = bool(entries & AWS_FORMS)
secrets = bool(entries & SECRETS_FORMS)
env     = bool(entries & ENV_FORMS)

def is_force_push_deny(entry):
    e = norm(entry)
    if not (e.startswith("Bash(") and e.endswith(")")):
        return False
    pat = e[len("Bash("):-1]
    if pat.endswith(":*"):
        pat = pat[:-2]  # strip the trailing argument matcher
    toks = pat.split()
    # Evaluate ONLY the first shell command: a flag appearing after a shell operator
    # (&&, ||, ;, |, &) belongs to a different command, not to git push —
    # 'Bash(git push origin main && echo --force:*)' must NOT count. Truncation happens
    # at the first token CONTAINING an operator character, so glued forms
    # ('main;echo') cannot smuggle a flag past the cut either.
    cut = len(toks)
    for i, t in enumerate(toks):
        if any(ch in t for ch in ";|&"):
            cut = i
            break
    toks = toks[:cut]
    if toks[:2] != ["git", "push"]:
        return False  # 'Bash(echo git push --force ...:*)' must NOT count
    return any(t in ("--force", "-f", "--force-with-lease") for t in toks[2:])

gpf = any(is_force_push_deny(e) for e in deny)

print(" ".join(["yes" if v else "no" for v in (ssh, env, aws, secrets, gpf)]
               + ["true" if schema_valid else "false"]))
AGENTFW_PROBE_PY
    ); then
      read -r deny_ssh deny_env deny_aws deny_secrets deny_git_push_force settings_schema_valid <<< "$probe_out"
      log "  deterministic_permissions: settings.json parsed — per-rule entries in permissions.deny (file is never modified by this tool):"
    else
      settings_present="unparseable"
      deny_ssh=unknown; deny_env=unknown; deny_aws=unknown; deny_secrets=unknown; deny_git_push_force=unknown
      settings_schema_valid=false
      log "  deterministic_permissions: settings.json present but not parseable as JSON — deny rules: unknown"
    fi
  fi
  log "    deny .ssh:               $deny_ssh"
  log "    deny .env:               $deny_env"
  log "    deny .aws:               $deny_aws"
  log "    deny secrets:            $deny_secrets"
  log "    deny git push --force:   $deny_git_push_force"
  log "    settings_schema_valid:   $settings_schema_valid (diagnostic, non-gating)"

  # Aggregate: true (all five yes) | partial (some yes) | false (none yes) | unknown (unreadable/unparseable).
  local dp_configured yes_count=0 unknown_count=0 v
  for v in "$deny_ssh" "$deny_env" "$deny_aws" "$deny_secrets" "$deny_git_push_force"; do
    case "$v" in
      yes) yes_count=$((yes_count + 1)) ;;
      unknown) unknown_count=$((unknown_count + 1)) ;;
    esac
  done
  if [ "$unknown_count" -gt 0 ]; then dp_configured=unknown
  elif [ "$yes_count" -eq 5 ]; then dp_configured=true
  elif [ "$yes_count" -gt 0 ]; then dp_configured=partial
  else dp_configured=false
  fi
  log "  deterministic_permissions_configured: $dp_configured"

  # independent_review: each shipped judge agent, by name.
  local agent_implementer=no agent_verifier=no agent_plan_critic=no
  [ -s "$AGENTS_DEST/agentfw-implementer.md" ] && agent_implementer=yes
  [ -s "$AGENTS_DEST/agentfw-verifier.md" ]    && agent_verifier=yes
  [ -s "$AGENTS_DEST/agentfw-plan-critic.md" ] && agent_plan_critic=yes
  log "  independent_review:        shipped agents in $AGENTS_DEST:"
  log "    agentfw-implementer.md:  $agent_implementer"
  log "    agentfw-verifier.md:     $agent_verifier"
  log "    agentfw-plan-critic.md:  $agent_plan_critic"

  # Installed validator (skill-relative Layer-1 plan check). Present means executable.
  local validator="$SKILL_DEST/tools/validate-plan" validator_present=no
  if [ -x "$validator" ]; then
    validator_present=yes
    log "  validator:                 $validator present + executable: yes"
  elif [ -f "$validator" ]; then
    log "  validator:                 $validator present but NOT executable — configured: no"
  else
    log "  validator:                 absent ($validator) — configured: no"
  fi

  # Install manifest (uninstall precision).
  local manifest_present=no
  if [ -f "$SKILL_DEST/.install-manifest" ]; then
    manifest_present=yes
    log "  manifest:                  $SKILL_DEST/.install-manifest present: yes"
  else
    log "  manifest:                  absent — pre-manifest install; uninstall falls back to the three known shipped agent filenames"
  fi

  # Command-critical utility resolution. `command -v` alone is insufficient: for a function it
  # commonly returns only the command name, which can be mistaken for a system binary. Persist its
  # output AND `type`'s classification so acceptance environments can cite what this status shell
  # actually resolves. Missing commands are non-fatal and carry an explicit status plus the real
  # (possibly empty) diagnostic output. `%q` keeps hostile multiline function bodies safe on the
  # console; yaml_quote provides the stronger structural encoding in the snapshot below.
  local resolution_commands=(grep sed find md5 sqlite3)
  local resolution_command_v=() resolution_command_v_status=()
  local resolution_type=() resolution_type_status=()
  local resolution_i resolution_utility resolution_out resolution_display
  log ""
  log "Command resolution (current status shell):"
  for ((resolution_i=0; resolution_i<${#resolution_commands[@]}; resolution_i++)); do
    resolution_utility="${resolution_commands[$resolution_i]}"
    if resolution_out=$(command -v "$resolution_utility" 2>&1); then
      resolution_command_v_status[$resolution_i]=resolved
    else
      resolution_command_v_status[$resolution_i]=missing
    fi
    resolution_command_v[$resolution_i]="$resolution_out"
    printf -v resolution_display '%q' "$resolution_out"
    log "  $resolution_utility command -v [${resolution_command_v_status[$resolution_i]}]: $resolution_display"

    if resolution_out=$(type "$resolution_utility" 2>&1); then
      resolution_type_status[$resolution_i]=resolved
    else
      resolution_type_status[$resolution_i]=missing
    fi
    resolution_type[$resolution_i]="$resolution_out"
    printf -v resolution_display '%q' "$resolution_out"
    log "  $resolution_utility type [${resolution_type_status[$resolution_i]}]: $resolution_display"
  done

  # --- active-capabilities.yaml ----------------------------------------------------------------
  # Persist the per-probe results next to the packaged capability.yaml so agents can read the
  # ACTIVE (probed) state without re-running the probes. Written only when the skill dir exists
  # (nothing installed => nowhere to record state); regenerated on every status run.
  if [ -d "$SKILL_DEST" ]; then
    local active="$SKILL_DEST/active-capabilities.yaml" ts
    ts="$(timestamp)"
    {
      printf '# active-capabilities.yaml — generated by agentfw-install status %s\n' "$ts"
      printf '# Per-probe configured-state snapshot for the packaged capability.yaml.\n'
      printf '# Regenerate any time: agentfw-install status\n'
      printf 'generated: "%s"\n' "$ts"
      printf 'deterministic_permissions:\n'
      printf '  settings_present: %s\n' "$settings_present"
      printf '  deny_ssh: %s\n' "$deny_ssh"
      printf '  deny_env: %s\n' "$deny_env"
      printf '  deny_aws: %s\n' "$deny_aws"
      printf '  deny_secrets: %s\n' "$deny_secrets"
      printf '  deny_git_push_force: %s\n' "$deny_git_push_force"
      printf '  settings_schema_valid: %s\n' "$settings_schema_valid"
      printf 'deterministic_permissions_configured: %s\n' "$dp_configured"
      printf 'independent_review:\n'
      printf '  agentfw_implementer: %s\n' "$agent_implementer"
      printf '  agentfw_verifier: %s\n' "$agent_verifier"
      printf '  agentfw_plan_critic: %s\n' "$agent_plan_critic"
      printf 'validator_present: %s\n' "$validator_present"
      printf 'manifest_present: %s\n' "$manifest_present"
      printf 'command_resolution:\n'
      for ((resolution_i=0; resolution_i<${#resolution_commands[@]}; resolution_i++)); do
        resolution_utility="${resolution_commands[$resolution_i]}"
        printf '  %s:\n' "$resolution_utility"
        printf '    command_v_status: %s\n' "${resolution_command_v_status[$resolution_i]}"
        printf '    command_v: '; yaml_quote "${resolution_command_v[$resolution_i]}"; printf '\n'
        printf '    type_status: %s\n' "${resolution_type_status[$resolution_i]}"
        printf '    type: '; yaml_quote "${resolution_type[$resolution_i]}"; printf '\n'
      done
    } > "$active"
    log ""
    log "Wrote probe snapshot -> $active (regenerated on every status run)"
  fi
}

do_install() {
  require_sources
  mkdir -p "$CLAUDE_DIR"
  require_no_unclosed_fence
  require_block_integrity
  if has_marker_block; then
    log "Existing AGENTFW block found — install behaves as upgrade (single block, replaced in place)."
    do_upgrade
    return
  fi
  if detect_legacy; then
    log "Marker-less legacy AgentFW content detected — install behaves as upgrade."
    do_upgrade
    return
  fi
  local bak=""
  if [ -f "$TARGET" ]; then
    bak=$(backup_target)
    log "Backed up existing CLAUDE.md -> $bak"
  fi
  touch "$TARGET"
  append_block
  copy_assets
  log "Inserted AgentFW $VERSION_TAG block into $TARGET (existing content preserved)."
  log "NOTE: settings.json is never auto-modified. Merge $ADAPTER_DIR/settings.example.json manually."
  log "Install complete."
}

do_upgrade() {
  require_sources
  mkdir -p "$CLAUDE_DIR"
  require_no_unclosed_fence
  require_block_integrity
  if [ ! -f "$TARGET" ]; then
    log "No existing CLAUDE.md — performing fresh install."
    touch "$TARGET"
    append_block
    copy_assets
    log "Install complete."
    return
  fi
  local bak
  if has_marker_block; then
    bak=$(backup_target)
    log "Backed up CLAUDE.md -> $bak"
    replace_block_in_place
    copy_assets
    log "Replaced existing AGENTFW block (any prior version tag) with $VERSION_TAG, in place."
    log "Upgrade complete."
    return
  fi
  if detect_legacy; then
    log "Detected marker-less legacy AgentFW install (r6/r7/r8 heading heuristics matched)."
    local range start end
    if ! range=$(legacy_excise_range); then
      die "legacy content detected but excision is ambiguous — refusing to guess. Merge manually: remove the old AgentFW sections from $TARGET yourself, then re-run 'agentfw-install install'. See adapters/claude-code/UPGRADE.md."
    fi
    start=${range% *}; end=${range#* }
    # The line-based rewrite below re-terminates every line; record an unterminated final
    # line FIRST so uninstall can restore the missing final newline byte-exactly.
    [ -n "$(tail -c 1 "$TARGET")" ] && NO_FINAL_NEWLINE=1
    bak=$(backup_target)
    log "Backed up CLAUDE.md (full original, including the excised AgentFW content) -> $bak"
    log "Excising legacy AgentFW content: lines $start-$end of $TARGET (everything else preserved)."
    local tmp block
    tmp="$(mktemp)"; block="$(mktemp)"
    emit_block > "$block"
    awk -v s="$start" -v e="$end" -v blockfile="$block" '
      NR == s { while ((getline line < blockfile) > 0) print line; close(blockfile) }
      NR >= s && NR <= e { next }
      { print }
    ' "$TARGET" > "$tmp"
    mv "$tmp" "$TARGET"
    rm -f "$block"
    copy_assets
    log "Upgrade complete (legacy content excised into backup; new $VERSION_TAG block inserted in place)."
    return
  fi
  log "No AgentFW content found in $TARGET — performing fresh install (append)."
  bak=$(backup_target)
  [ -n "${bak:-}" ] && log "Backed up CLAUDE.md -> $bak"
  append_block
  copy_assets
  log "Install complete."
}

do_uninstall() {
  local removed=0
  require_no_unclosed_fence
  require_block_integrity
  # Snapshot the install manifest BEFORE removing the skill dir it lives in.
  local manifest="$SKILL_DEST/.install-manifest" mtmp=""
  if [ -f "$manifest" ]; then
    mtmp="$(mktemp)"
    cp "$manifest" "$mtmp"
  fi
  log "AgentFW $VERSION_TAG uninstall — inventory of removals:"
  if has_marker_block; then
    local bak tmp
    bak=$(backup_target)
    log "  - Backed up CLAUDE.md before edit -> $bak"
    tmp="$(mktemp)"
    # Strip every AGENTFW block (any version tag) plus the single separating blank line the
    # installer added before it, restoring the user's file byte-for-byte. Fence state is
    # tracked in streaming order; marker lines are classified into T[] as they are read, so
    # the END-phase deletion pass sees only REAL (unfenced) markers.
    awk "$FENCE_TRACKER"'
      { L[NR] = $0
        if (!infence && $0 ~ /^<!-- AGENTFW:BEGIN /) T[NR] = 1
        else if (!infence && $0 ~ /^<!-- AGENTFW:END /) T[NR] = 2
      }
      END {
        inb = 0
        for (i = 1; i <= NR; i++) {
          if (T[i] == 1) {
            inb = 1; del[i] = 1
            if (i > 1 && L[i-1] ~ /^[[:space:]]*$/ && !del[i-1]) del[i-1] = 1
          } else if (T[i] == 2) {
            del[i] = 1; inb = 0
          } else if (inb) del[i] = 1
        }
        for (i = 1; i <= NR; i++) if (!del[i]) print L[i]
      }
    ' "$TARGET" > "$tmp"
    if grep -q '[^[:space:]]' "$tmp"; then
      mv "$tmp" "$TARGET"
      # Manifest directive says the ORIGINAL pre-install file ended without a final newline
      # (append_block had to add one) — strip it again for a byte-exact restore.
      if [ -n "$mtmp" ] && grep -qF "$NO_FINAL_NEWLINE_DIRECTIVE" "$mtmp" 2>/dev/null \
         && [ -s "$TARGET" ] && [ -z "$(tail -c 1 "$TARGET")" ]; then
        local nfsz nftmp
        nfsz=$(wc -c < "$TARGET")
        nftmp="$(mktemp)"
        head -c $((nfsz - 1)) "$TARGET" > "$nftmp"
        mv "$nftmp" "$TARGET"
        log "  - Restored the original MISSING final newline in $TARGET (recorded at install time)"
      fi
      log "  - Removed AGENTFW marker block(s) from $TARGET (all other content preserved)"
    else
      rm -f "$tmp" "$TARGET"
      log "  - $TARGET contained only the AgentFW block — file removed"
    fi
    removed=1
  else
    log "  - No AGENTFW marker block in ${TARGET} (nothing to remove there)"
  fi
  if [ -d "$SKILL_DEST" ]; then
    rm -rf "$SKILL_DEST"
    log "  - Removed skill dir $SKILL_DEST (including policy/, tools/validate-plan, and the install manifest — consumed)"
    removed=1
  else
    log "  - Skill dir absent ($SKILL_DEST)"
  fi
  # Agent removal is manifest-driven: remove EXACTLY the agent files the installer
  # recorded — never a glob, so user-created agentfw-*.md files are never touched.
  local f name found=0
  if [ -n "$mtmp" ]; then
    log "  - Using install manifest (only files the installer recorded are removed)"
    while IFS= read -r line; do
      case "$line" in ''|\#*) continue ;; esac
      case "$line" in
        /*|*..*) log "  - SKIPPED suspicious manifest entry (not CLAUDE_DIR-relative): $line"; continue ;;
      esac
      case "$line" in
        agents/*.md)
          if [ -f "$CLAUDE_DIR/$line" ]; then
            rm -f "$CLAUDE_DIR/$line"
            log "  - Removed agent $CLAUDE_DIR/$line (manifest entry)"
            found=1; removed=1
          fi
          ;;
        skills/agentfw) ;;   # handled above as the skill-dir removal
        *) log "  - Ignored manifest entry outside expected namespaces: $line" ;;
      esac
    done < "$mtmp"
    rm -f "$mtmp"
  else
    log "  - No install manifest (pre-manifest legacy install) — falling back to the three"
    log "    known shipped agent filenames (never a glob; your own agentfw-*.md files are kept)"
    for name in agentfw-implementer.md agentfw-verifier.md agentfw-plan-critic.md; do
      f="$AGENTS_DEST/$name"
      if [ -f "$f" ]; then
        rm -f "$f"
        log "  - Removed agent $f"
        found=1; removed=1
      fi
    done
  fi
  [ "$found" -eq 0 ] && log "  - No shipped agentfw agent files to remove in $AGENTS_DEST"
  log "NOT removed (intentional): backup files ($CLAUDE_DIR/CLAUDE.md.agentfw-backup-*) and any"
  log "settings.json entries you merged manually — remove those by hand (see UNINSTALL.md)."
  [ "$removed" -eq 1 ] && log "Uninstall complete." || log "Nothing was installed; nothing removed."
}

usage() {
  cat <<EOF
Usage: agentfw-install <install|upgrade|uninstall|status>

Target: \${CLAUDE_DIR:-\$HOME/.claude}  (currently: $CLAUDE_DIR)

  install    Insert the AgentFW $VERSION_TAG block into CLAUDE.md (backup first; append —
             never overwrite user content), install the agentfw skill (+ policy/ +
             tools/validate-plan), the agentfw-* agents, and an install manifest.
             Idempotent: an existing block makes install behave as upgrade.
  upgrade    Replace any existing AGENTFW block (any version tag); detect marker-less r6/r7/r8
             installs by heading heuristics and conservatively excise them into a backup;
             refuse when ambiguous. Refreshes skill, validator, agents, manifest.
  uninstall  Remove the block, the skill dir, and EXACTLY the manifest-recorded agent files
             (legacy fallback: the three known shipped filenames — never a glob; user-created
             agentfw-*.md files are never touched); preserve everything else byte-for-byte;
             remove CLAUDE.md if it becomes empty; print an inventory.
  status     Report block presence/version, skill dir, agent files, plus configured-state
             probes (settings.json parsed as JSON: per-rule permissions.deny entries
             yes/no/unknown + a deterministic_permissions_configured aggregate
             true/partial/false/unknown, installed validator,
             manifest, each shipped agent) mapped to the packaged capability.yaml
             activation_probe entries; write the probe snapshot to
             skills/agentfw/active-capabilities.yaml when the skill dir exists. The snapshot
             also records command -v + type resolution for grep, sed, find, md5, and sqlite3,
             including wrappers/functions and missing commands. Warns (exit 0)
             on malformed markers or an unclosed code fence; the mutating subcommands above
             REFUSE byte-untouched on either condition.
EOF
}

cmd="${1:-}"
case "$cmd" in
  install)   do_install ;;
  upgrade)   do_upgrade ;;
  uninstall) do_uninstall ;;
  status)    do_status ;;
  ""|-h|--help) usage; [ -n "$cmd" ] || exit 1 ;;
  *) usage; die "unknown subcommand: $cmd" ;;
esac
