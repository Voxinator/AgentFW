+def channel_pollution_depth(messages):
+    """Count assistant turns whose content is exclusively channel/tool_call sentinel markers."""
+    n = 0
+    for m in messages:
+        if m.get("role") != "assistant":
+            continue
+        c = (m.get("content") or "").strip()
+        if not c:
+            continue
+        if _MARKER_ONLY_RE.match(c):
+            n += 1
+    return n
+
