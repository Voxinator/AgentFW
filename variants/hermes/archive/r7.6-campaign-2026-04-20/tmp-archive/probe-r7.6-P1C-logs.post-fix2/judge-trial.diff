+# ------------- r7.6 P1-C fix2 (rev 2): expanded marker-only + pseudo-tool-call detectors ----------------
+# Class A — marker-only assistant content (Harmony/Gemma channel-sentinel leakage).
+# Expanded from rev-1 `<channel|>`-only to cover all observed pure-marker variants:
+#   <channel|>, <|channel|>, <tool_call|>, <start|>, <end|>, <message|>, <return|>,
+#   "thought\n<channel|>" and "analysis\n<channel|>" headers.
+_MARKER_ONLY_RE = re.compile(
+    r"^\s*(?:"
+    r"(?:<\|?(channel|tool_call|start|end|message|return)\|?>\s*)"
+    r"|(?:thought\s*<\|?channel\|?>\s*)"
+    r"|(?:analysis\s*<\|?channel\|?>\s*)"
+    r")+\s*$",
+    re.IGNORECASE | re.DOTALL,
+)
+
+# Class B — pseudo-tool-call as markdown fenced text (model halts mid-plan and
+# emits what should have been a structured tool_call as rendered code-fenced text).
+# The spec regex (full-content anchored) is kept for whole-content detection; a
+# second tail-anchored variant catches the more common pattern where lots of prose
+# precedes a halted pseudo-tool-call at the END of the message (fresh verdict 3:
+# armB-T5-run1).
+_PSEUDO_TOOL_CALL_RE = re.compile(
+    r"^\s*```[\w]*\s*\n?"
+    r"(?:search_files|read_file|write_file|patch|terminal|todo|clarify|delegate_\w+)"
+    r"\s*\([^)]*\)\s*\n?```?\s*$",
+    re.IGNORECASE | re.DOTALL,
+)
+_PSEUDO_TOOL_CALL_TAIL_RE = re.compile(
+    r"```[\w]*\s*\n"
+    r"(?:search_files|read_file|write_file|patch|terminal|todo|clarify|delegate_\w+)"
+    r"\s*\([^)]*\)\s*\n?```?\s*$",
+    re.IGNORECASE | re.DOTALL,
+)
