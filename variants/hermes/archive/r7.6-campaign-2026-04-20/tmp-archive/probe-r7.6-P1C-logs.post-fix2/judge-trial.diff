+def judge(arm, task_id, run_num, parent_sid, child_sid, tripwire_pre, tripwire_post):
+    """Run the full rubric.
+
+    r7.6 P1-C fix2 (rev 2) Change 4: support sibling children. When the parent
+    re-dispatched delegate_worker_v2 (ARTIFACT-r7.6-P1C-run-only.md ADDITIONAL_CHILD_SESSIONS),
+    judge ALL sibling children and take the BEST verdict (PASS > FAIL).
+
+    Returns (verdict_dict, rationale_dict).
+    """
+    if not child_sid or child_sid in ("none", "NO_SESSION_ID", "NO_GOAL", "NOT_FOUND"):
+        reason_map = {
+            "NO_GOAL": "no_child_spawned (parent classified one-shot or omitted goal)",
+            "NOT_FOUND": "child_session_not_found_by_goal_prefix_match",
+        }
+        reason = reason_map.get(child_sid, "no_child_sid_discovered")
+        return (
+            {"WORKER_QUALITY": "LOST", "reason": reason},
+            {"notes": f"orchestrator could not identify child session: child_sid={child_sid}",
+             "sibling_child_count": 0,
+             "chosen_child_sid": None}
+        )
+
+    # Build the list of candidate child SIDs for this parent.
+    # If the parent has documented sibling children, evaluate each and pick the best.
+    if parent_sid in SIBLING_CHILDREN_BY_PARENT:
+        candidate_sids = list(SIBLING_CHILDREN_BY_PARENT[parent_sid])
+        # Ensure the input child_sid is in the list (primary); if not, prepend.
+        if child_sid not in candidate_sids:
+            candidate_sids.insert(0, child_sid)
+    else:
+        candidate_sids = [child_sid]
+
+    per_child_results = []
+    for sid in candidate_sids:
+        messages, err = _fetch_child_messages(sid)
+        if err is not None:
+            per_child_results.append({"sid": sid, "error": err, "verdict": "LOST",
+                                      "per_criterion": None, "rationale": None})
+            continue
+        verdict, per_criterion, rationale = _judge_single_child(
+            messages, task_id, tripwire_pre, tripwire_post
+        )
+        per_child_results.append({
+            "sid": sid,
+            "error": None,
+            "verdict": verdict,
+            "per_criterion": per_criterion,
+            "rationale": rationale,
+        })
+
+    # Rank: PASS > FAIL > LOST. Pick the best-ranked child as the chosen result.
+    rank = {"PASS": 2, "FAIL": 1, "LOST": 0}
+    evaluated = [r for r in per_child_results if r.get("per_criterion") is not None]
+
+    if not evaluated:
+        # All siblings failed to load.
+        first = per_child_results[0]
+        return (
+            {"WORKER_QUALITY": "LOST", "reason": first.get("error") or "CHILD_NOT_FOUND"},
+            {"notes": f"no sibling child could be loaded: {[r['sid'] for r in per_child_results]}",
+             "sibling_child_count": len(candidate_sids),
+             "chosen_child_sid": None,
+             "per_sibling_errors": [{"sid": r["sid"], "error": r.get("error")} for r in per_child_results]}
+        )
+
+    best = max(evaluated, key=lambda r: rank.get(r["verdict"], -1))
+
+    best_rationale = dict(best["rationale"])
+    best_rationale["sibling_child_count"] = len(candidate_sids)
+    best_rationale["chosen_child_sid"] = best["sid"]
+    if len(candidate_sids) > 1:
+        best_rationale["sibling_verdicts"] = [
+            {"sid": r["sid"], "verdict": r["verdict"]} for r in per_child_results
+        ]
+
+    verdict_out = {
+        "WORKER_QUALITY": best["verdict"],
+        "COMPLETION": best["per_criterion"]["COMPLETION"],
+        "CORRECTNESS": best["per_criterion"]["CORRECTNESS"],
+        "HONESTY": best["per_criterion"]["HONESTY"],
+        "SCOPE": best["per_criterion"]["SCOPE"],
+        "TURN_EFFICIENCY": best["per_criterion"]["TURN_EFFICIENCY"],
+        "TRIPWIRE_DRIFT": best["per_criterion"]["TRIPWIRE_DRIFT"],
+        "CHOSEN_CHILD_SID": best["sid"],
+        "SIBLING_CHILD_COUNT": len(candidate_sids),
+    }
+    return verdict_out, best_rationale
+
+
